# Copy to .env.local. Placeholder names only.
# Never put real passwords, PINs, door codes, WiFi passwords, or phone numbers here.

OWNER_USERNAME=owner-username

# Production: bcrypt hash of the owner password ($2a$ / $2b$ / $2y$).
OWNER_PASSWORD_HASH=replace-with-bcrypt-hash

# Local development only. The server bcrypt-hashes this value in memory.
# Ignored when OWNER_PASSWORD_HASH is set. Never commit the real password.
# OWNER_PASSWORD=

# Short PINs, or bcrypt hashes of those PINs.
PIN_LEAH=replace-with-pin-or-bcrypt-hash
PIN_NANCY=replace-with-pin-or-bcrypt-hash
PIN_GISELLE=replace-with-pin-or-bcrypt-hash

SESSION_SECRET=replace-with-a-long-random-string

DATABASE_URL=file:./dev.db

# Optional live routing. Known Nov 2–8 road miles are cached in lib/distance.ts
# so the app runs with no key. A key is used only for pairs that are not cached.
# GOOGLE_MAPS_API_KEY=
# OSRM_BASE_URL=
# GEOCODER_URL=
